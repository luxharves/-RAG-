# OpenAI-compatible LLM endpoint
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# OpenAI-compatible Qwen3-VL endpoint
VLM_BASE_URL=https://api.example.com/v1
VLM_API_KEY=replace-me
VLM_MODEL=replace-me

# Milvus — use "milvus.db" for local Milvus Lite, or "http://localhost:19530" for server
MILVUS_URI=milvus.db
MILVUS_TOKEN=

# Local model settings — can be HF model names or local paths
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-large
MODEL_DEVICE=auto

# Application
LOG_LEVEL=INFO
DATA_DIR=data
STORAGE_DIR=storage

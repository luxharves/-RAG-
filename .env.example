# OpenAI-compatible LLM endpoint
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# OpenAI-compatible Qwen3-VL endpoint
VLM_BASE_URL=https://api.example.com/v1
VLM_API_KEY=replace-me
VLM_MODEL=replace-me

# Milvus — use "milvus.db" for local Milvus Lite, or "http://localhost:19530" for server
MILVUS_URI=milvus.db
MILVUS_TOKEN=

# Local model settings — can be HF model names or local paths
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-large
MODEL_DEVICE=auto

# Application
LOG_LEVEL=INFO
DATA_DIR=data
STORAGE_DIR=storage

# V6 Grounding verifier
# verifier_mode: "grounding" (deterministic, default) | "llm" (V4 LLM-as-judge)
VERIFIER_MODE=grounding
# grounding_scorer: "reranker" (cross-encoder, default) | "cosine" (BGE-M3 bi-encoder)
GROUNDING_SCORER=reranker
# cross-encoder support floor for a sentence to be considered grounded
GROUNDING_SCORER_FLOOR=0.1
# cosine-path thresholds (only used when GROUNDING_SCORER=cosine)
GROUNDING_INITIAL_THRESHOLD=0.55
GROUNDING_THRESHOLD_FLOOR=0.35
GROUNDING_THRESHOLD_DECAY=0.9
# min fraction of answer sentences that must be grounded to answer
GROUNDING_MIN_SUPPORT_RATIO=0.7

# V7 LLM gateway (retry / circuit breaker / failover / timeout)
# per-attempt timeout in seconds (SDK default was 600s — a hung API could block 10 min)
LLM_TIMEOUT=60.0
# attempts per provider = LLM_MAX_RETRIES + 1; exponential backoff base/multiplier/cap
LLM_MAX_RETRIES=2
LLM_RETRY_BASE=1.0
LLM_RETRY_MULTIPLIER=2.0
LLM_RETRY_CAP=8.0
# circuit breaker: open after N consecutive failures, cooldown before HALF_OPEN probe
LLM_CIRCUIT_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN=30.0
# canned answer when ALL providers are down (contains "无法回答此问题" → VerifiedQA self-refusal)
LLM_FALLBACK_ANSWER=模型服务暂时不可用，无法回答此问题，请稍后重试。
# Optional backup providers for cross-provider failover. Fill all three to activate.
# When filled, LLMClient automatically retries the chain: primary → 2 → 3.
LLM_BASE_URL_2=
LLM_API_KEY_2=
LLM_MODEL_2=
LLM_BASE_URL_3=
LLM_API_KEY_3=
LLM_MODEL_3=

# V9 semantic cache
# exact (SHA256) + semantic (BGE-M3 cosine > threshold) two-level cache at /query
CACHE_ENABLED=true
CACHE_THRESHOLD=0.9
CACHE_TTL_DAYS=
CACHE_DB_PATH=storage/semantic_cache.db
